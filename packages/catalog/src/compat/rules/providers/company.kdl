// Fork-owned intranet lane. The runtime supplies the cached Claude endpoint;
// these rows are never bundled or discovered from a public catalog.
provider "company" {
	default-model "GLM-5.3-public"
	seed api="anthropic-messages" base-url="" bundle="never" {
		model "DeepSeek-V4-Flash-public" name="DeepSeek-V4-Flash-public" {
			reasoning #true
			supports-tools #true
			input "text"
			cost input=0 output=0 cache-read=0 cache-write=0
			limits context=1000000 max-tokens=81920
			thinking-mode "budget"
			thinking-efforts "minimal" "low" "medium" "high"
		}
		model "Deepseek-v4.1-Flash" name="Deepseek-v4.1-Flash" {
			reasoning #true
			supports-tools #true
			input "text" "image"
			cost input=0 output=0 cache-read=0 cache-write=0
			limits context=1000000 max-tokens=81920
			thinking-mode "budget"
			thinking-efforts "minimal" "low" "medium" "high"
		}
		model "GLM-5.2-public" name="GLM-5.2-public" {
			reasoning #true
			supports-tools #true
			input "text"
			cost input=0 output=0 cache-read=0 cache-write=0
			limits context=1000000 max-tokens=81920
			thinking-mode "budget"
			thinking-efforts "minimal" "low" "medium" "high"
		}
		model "GLM-5.3-public" name="GLM-5.3-public" {
			reasoning #true
			supports-tools #true
			input "text"
			cost input=0 output=0 cache-read=0 cache-write=0
			limits context=1000000 max-tokens=81920
			// Measured company gateway dialect: high can skip reasoning entirely;
			// ultra is the stable deep-thinking tier. OMP exposes it as xhigh.
			supports-output-effort #true
			thinking-mode "anthropic-budget-effort"
			thinking-default-level "medium"
			thinking-efforts "low" "medium" "xhigh" "max"
			thinking-effort-map {
				xhigh "ultra"
			}
		}
		model "MiniMax-M2.7" name="MiniMax-M2.7" {
			reasoning #true
			supports-tools #true
			input "text"
			cost input=0 output=0 cache-read=0 cache-write=0
			limits context=204800 max-tokens=81920
			thinking-mode "budget"
			thinking-efforts "minimal" "low" "medium" "high"
		}
		model "Qwen3.6-27B-public" name="Qwen3.6-27B-public" {
			reasoning #true
			supports-tools #true
			input "text" "image"
			cost input=0 output=0 cache-read=0 cache-write=0
			limits context=262144 max-tokens=81920
			thinking-mode "budget"
			thinking-efforts "minimal" "low" "medium" "high"
		}
		model "Qwen3.6-35B-A3B" name="Qwen3.6-35B-A3B" {
			reasoning #true
			supports-tools #true
			input "text" "image"
			cost input=0 output=0 cache-read=0 cache-write=0
			limits context=262144 max-tokens=81920
			thinking-mode "budget"
			thinking-efforts "minimal" "low" "medium" "high"
		}
		model "Qwen3.8-27B" name="Qwen3.8-27B" {
			reasoning #true
			supports-tools #true
			input "text" "image"
			cost input=0 output=0 cache-read=0 cache-write=0
			limits context=262144 max-tokens=81920
			thinking-mode "budget"
			thinking-efforts "minimal" "low" "medium" "high"
		}
	}
	supports-context-management #false
	supports-output-effort #false
	disable-strict-tools #true
	disable-adaptive-thinking #true
	// residue: this exact company SKU retains its 256K window after the offline default override.
	models "Qwen3.8-27B" {
		limits-patch {
			context-window 262144
		}
	}
}
