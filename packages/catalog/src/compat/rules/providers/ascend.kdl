// Ascend's fixed Anthropic-compatible roster; no public catalog discovery.
provider "ascend" {
	default-model "minimax2.7"
	env "ASCEND_API_KEY"
	automatic-default #false
	skip-cross-provider-reference-fills #true
	disable-strict-tools #true

	// These deployment aliases share Ascend's explicit budget-plus-effort contract.
	models "qwen3.8-27b" "qwen3.8-flash-next" {
		thinking-mode "anthropic-budget-effort"
		thinking-efforts "low" "medium" "high" "xhigh"
		thinking-default-level "xhigh"
		thinking-effort-map {
			high "xhigh"
		}
	}

	seed api="anthropic-messages" base-url="http://models.ascend.huawei.com" precedence="seed" {
		model "minimax2.7" name="minimax2.7" {
			reasoning #true
			supports-tools #true
			input "text"
			cost input=0 output=0 cache-read=0 cache-write=0
			limits context=200000 max-tokens=32768
		}
		model "kimi-k2.6" name="kimi-k2.6" {
			reasoning #true
			supports-tools #true
			input "text"
			cost input=0 output=0 cache-read=0 cache-write=0
			limits context=200000 max-tokens=32768
		}
		model "deepseek-v4-flash" name="deepseek-v4-flash" {
			reasoning #true
			supports-tools #true
			input "text"
			cost input=0 output=0 cache-read=0 cache-write=0
			limits context=200000 max-tokens=32768
		}
		model "qwen3.8-27b" name="qwen3.8-27b" {
			reasoning #true
			supports-tools #true
			input "text"
			cost input=0 output=0 cache-read=0 cache-write=0
			limits context=256000 max-tokens=32768
		}
		model "qwen-aw-35b" name="qwen-aw-35b" {
			reasoning #true
			supports-tools #true
			input "text" "image"
			cost input=0 output=0 cache-read=0 cache-write=0
			limits context=200000 max-tokens=32768
		}
		model "qwen3.8-flash-next" name="qwen3.8-flash-next" {
			reasoning #true
			supports-tools #true
			input "text" "image"
			cost input=0 output=0 cache-read=0 cache-write=0
			limits context=256000 max-tokens=32768
		}
	}
}
