// fork: provider-wire compat for "zcode-api" — the local ZCode Proxy relaying
// the domestic Zhipu coding plan over its Anthropic Messages route. Model rows
// are built at runtime (packages/coding-agent/src/config/zcode-api-models.ts);
// there is deliberately no models.json block (loopback endpoints are banned
// from the bundled catalog).

provider "zcode-api" {
	// Preserve the first-row fallback of the original runtime roster.
	default-model "glm-4.5"
	env "ZCODE_API_KEY" "ZCODE_PROXY_API_KEY"
	seed api="anthropic-messages" base-url="http://127.0.0.1:8080" bundle="never" {
		model "glm-4.5" name="GLM-4.5" {
			reasoning #true
			input "text"
			cost input=0 output=0 cache-read=0 cache-write=0
			limits context=131072 max-tokens=98304
		}
		model "glm-4.5-air" name="GLM-4.5-Air" {
			reasoning #true
			input "text"
			cost input=0 output=0 cache-read=0 cache-write=0
			limits context=131072 max-tokens=98304
		}
		model "glm-4.6" name="GLM-4.6" {
			reasoning #true
			input "text"
			cost input=0 output=0 cache-read=0 cache-write=0
			limits context=202752 max-tokens=131072
		}
		model "glm-4.6v" name="GLM-4.6V" {
			reasoning #true
			input "text" "image"
			cost input=0.3 output=0.9 cache-read=0 cache-write=0
			limits context=128000 max-tokens=32768
		}
		model "glm-4.7" name="GLM-4.7" {
			reasoning #true
			input "text"
			cost input=0 output=0 cache-read=0 cache-write=0
			limits context=204800 max-tokens=131072
		}
		model "glm-5" name="GLM-5" {
			reasoning #true
			input "text"
			cost input=0 output=0 cache-read=0 cache-write=0
			limits context=204800 max-tokens=131072
		}
		model "glm-5-turbo" name="GLM-5-Turbo" {
			reasoning #true
			input "text"
			cost input=0 output=0 cache-read=0 cache-write=0
			limits context=200000 max-tokens=131072
		}
		model "glm-5v-turbo" name="GLM-5V-Turbo" {
			reasoning #true
			input "text" "image"
			cost input=0 output=0 cache-read=0 cache-write=0
			limits context=200000 max-tokens=131072
		}
		model "glm-5.1" name="GLM-5.1" {
			reasoning #true
			input "text"
			cost input=0 output=0 cache-read=0 cache-write=0
			limits context=200000 max-tokens=131072
		}
		model "glm-5.2" name="GLM-5.2" {
			reasoning #true
			input "text"
			cost input=0 output=0 cache-read=0 cache-write=0
			limits context=1000000 max-tokens=131072
		}
		model "glm-5.2-highspeed" name="GLM-5.2 Highspeed" {
			reasoning #true
			input "text"
			cost input=0 output=0 cache-read=0 cache-write=0
			limits context=1000000 max-tokens=131072
		}
		model "glm-5.3" name="GLM-5.3" {
			reasoning #true
			input "text"
			cost input=0 output=0 cache-read=0 cache-write=0
			limits context=1000000 max-tokens=131072
		}
		model "glm-5.3-flash" name="GLM-5.3-Flash" {
			reasoning #true
			input "text" "image"
			cost input=0 output=0 cache-read=0 cache-write=0
			limits context=1000000 max-tokens=131072
		}
		model "glm-5.3-highspeed" name="GLM-5.3 Highspeed" {
			reasoning #true
			input "text"
			cost input=0 output=0 cache-read=0 cache-write=0
			limits context=1000000 max-tokens=131072
		}
	}
	// GLM coding-plan endpoints require the tool_use id mirrored onto
	// tool_result blocks (same Z.AI workaround as provider "zai", issue #814).
	requires-tool-result-id #true
	// Coding-plan effort sets: pre-5.2 SKUs serve minimal..high; glm-5.2*
	// serves high/max; glm-5.3* serves low/high/max with default max (the
	// class `*glm-5.3*` rule). Without these rules the Anthropic-route
	// fallback ladder would admit xhigh on the pre-5.2 SKUs, which the
	// coding-plan lane does not serve.
	class "glm" {
		revision "<5.2" {
			thinking-efforts "minimal" "low" "medium" "high"
			thinking-mode "budget"
		}
		// The vision SKU's digits run into a letter (`glm-5v-turbo`), so it
		// carries no revision and needs the family selector.
		family "vision" {
			thinking-efforts "minimal" "low" "medium" "high"
			thinking-mode "budget"
		}
	}
	models "glm-5.2*" {
		thinking-efforts "high" "max"
		thinking-mode "anthropic-budget-effort"
	}
	models "glm-5.3" "glm-5.3-flash" "glm-5.3-highspeed" {
		thinking-mode "anthropic-budget-effort"
	}
}
