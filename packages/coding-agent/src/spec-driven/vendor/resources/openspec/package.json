{
  "name": "@fission-ai/openspec",
  "version": "2.0.0",
  "description": "AI-native system for spec-driven development",
  "keywords": [
    "openspec",
    "specs",
    "cli",
    "ai",
    "development"
  ],
  "homepage": "https://github.com/Fission-AI/OpenSpec",
  "repository": {
    "type": "git",
    "url": "https://github.com/Fission-AI/OpenSpec"
  },
  "license": "MIT",
  "author": "FISSION AI INC",
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "openspec": "./bin/openspec.js"
  },
  "files": [
    "dist",
    "bin",
    "schemas",
    "!dist/**/*.map"
  ],
  "scripts": {
    "build": "node build.js",
    "dev": "tsc --watch",
    "dev:cli": "pnpm build && node bin/openspec.js",
    "prepare": "node build.js",
    "prepublishOnly": "pnpm run build"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "@types/node": "^22.12.0",
    "@types/picomatch": "^4.0.3",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@inquirer/core": "^12.0.0",
    "@inquirer/prompts": "^8.5.2",
    "brace-expansion": "^5.0.12",
    "chalk": "^5.6.2",
    "commander": "^14.0.0",
    "cross-spawn": "7.0.6",
    "diff": "^9.0.0",
    "ora": "^9.4.1",
    "picomatch": "^4.0.4",
    "tinyglobby": "^0.2.17",
    "yaml": "^2.8.3",
    "zod": "^4.4.3"
  }
}
