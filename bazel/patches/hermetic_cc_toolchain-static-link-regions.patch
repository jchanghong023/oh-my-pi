--- a/toolchain/zig-wrapper.zig
+++ b/toolchain/zig-wrapper.zig
@@ -270,7 +270,7 @@
     // lld does not handle the colon-link syntax (-l :filename or -l:filename).
     // Resolve such flags to full paths by searching the -L directories.
     if (run_mode == RunMode.cc)
-        try resolveColonLibraries(arena, cwd, &args);
+        try resolveLibraries(arena, cwd, &args);
 
     // Compile-only steps (-c/-E/-S) get a private throwaway cache: concurrent
     // zig processes sharing one cache corrupt it (ziglang/zig#18763), and the
@@ -312,10 +312,10 @@
     return ParseResults{ .exec = .{ .args = args, .env = env } };
 }
 
-// Workaround for https://github.com/ziglang/zig/issues/23287: zig 0.14.0 lld
-// does not handle the colon-link syntax (-l:filename). When we see "-l" followed
-// by ":filename", resolve it to a full path by searching the -L directories.
-fn resolveColonLibraries(
+// Resolve colon-link names and libraries selected inside static-link regions.
+// Zig 0.14 otherwise searches only for shared libraries for -l names even when
+// rustc surrounds them with -Wl,-Bstatic / -Wl,-Bdynamic.
+fn resolveLibraries(
     arena: mem.Allocator,
     cwd: fs.Dir,
     args: *ArrayListUnmanaged([]const u8),
@@ -326,18 +326,36 @@
             try lib_paths.append(arena, arg[2..]);
     }
 
+    var static_link = false;
     var i: usize = 0;
-    while (i + 1 < args.items.len) : (i += 1) {
-        if (!mem.eql(u8, args.items[i], "-l")) continue;
-        const next = args.items[i + 1];
-        if (!mem.startsWith(u8, next, ":")) continue;
-
-        const filename = next[1..];
+    while (i < args.items.len) : (i += 1) {
+        const arg = args.items[i];
+        if (mem.eql(u8, arg, "-Wl,-Bstatic")) {
+            static_link = true;
+            continue;
+        }
+        if (mem.eql(u8, arg, "-Wl,-Bdynamic")) {
+            static_link = false;
+            continue;
+        }
+        const separate_name = mem.eql(u8, arg, "-l") and i + 1 < args.items.len;
+        const name = if (separate_name)
+            args.items[i + 1]
+        else if (mem.startsWith(u8, arg, "-l") and arg.len > 2)
+            arg[2..]
+        else
